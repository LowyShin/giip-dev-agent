{
  "_comment": "CSN → 処理プロジェクトフォルダのマッピング。この例をコピーして csn-projects.json(gitignore対象)として実データを入れる。新CSN追加 = ここに項目を1つ追加するだけ。詳細は README.md 参照。",
  "csn": {
    "<CSN番号>": {
      "project": "<プロジェクトフォルダ名(任意のラベル)>",
      "workdir": "<このCSNの対象プロジェクトの絶対パス>",
      "restBranch": "<省略可 — このプロジェクトの常用作業ブランチが git リモートの既定ブランチ(main/master)と異なる場合のみ指定(例: dev-first運用のプロジェクトなら \"dev\")。指定しないと busy-check がその状態を毎回 BUSY と誤認し、強制アンブロックを繰り返す。>",
      "enabled": true,
      "note": "<このCSN/プロジェクト固有の注意事項・性域(コード修正禁止)ファイルなどをここに記録>"
    }
  }
}
